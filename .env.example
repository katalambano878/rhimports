# App
NEXT_PUBLIC_APP_URL=https://rnhimports.com
NEXT_PUBLIC_SITE_NAME=RNH Imports
NEXT_PUBLIC_SITE_DESCRIPTION=Trusted importation and logistics company based in Ghana. Sourcing quality products from China, delivered to your door.

# Database (plain Postgres on big-vps). The app serves the Supabase-compatible
# /rest/v1, /auth/v1 and /storage/v1 endpoints itself, so the browser client
# points NEXT_PUBLIC_SUPABASE_URL at this site.
DATABASE_URL=postgresql://store_rhimports:PASSWORD@fleet-postgres:5432/store_rhimports
DB_ANON_ROLE=rnh_anon
DB_AUTHENTICATED_ROLE=rnh_authenticated
PG_POOL_MAX=8
AUTH_JWT_SECRET=RANDOM_64_HEX
STORAGE_SIGNING_SECRET=RANDOM_64_HEX
STORAGE_ROOT=/app/storage
NEXT_PUBLIC_SUPABASE_URL=https://www.rnhimports.com
# HS256 JWTs signed with AUTH_JWT_SECRET: {"role":"anon"} and {"role":"service_role"}
NEXT_PUBLIC_SUPABASE_ANON_KEY=ANON_JWT
SUPABASE_SERVICE_ROLE_KEY=SERVICE_ROLE_JWT

# Email (Resend)
RESEND_API_KEY=YOUR_RESEND_API_KEY
ADMIN_EMAIL=info@rnhimports.com
EMAIL_FROM=RNH Imports <noreply@rnhimports.com>

# Payments (Hubtel, Moolre)

# Hubtel (PRIMARY gateway)
HUBTEL_API_ID=YOUR_HUBTEL_API_ID
HUBTEL_API_KEY=YOUR_HUBTEL_API_KEY
HUBTEL_MERCHANT_ACCOUNT_NUMBER=YOUR_HUBTEL_COLLECTION_ACCOUNT_NUMBER

# Moolre
MOOLRE_API_USER=YOUR_MOOLRE_API_USER
MOOLRE_API_PUBKEY=YOUR_MOOLRE_API_PUBKEY
MOOLRE_ACCOUNT_NUMBER=YOUR_MOOLRE_ACCOUNT_NUMBER
MOOLRE_MERCHANT_EMAIL=merchant@rnhimports.com
MOOLRE_SMS_API_KEY=YOUR_MOOLRE_SMS_API_KEY
MOOLRE_CALLBACK_SECRET=YOUR_MOOLRE_CALLBACK_SECRET

# SMS
SMS_SENDER_ID=RNHImports

# Store Business Info (LocalBusiness schema)
NEXT_PUBLIC_STORE_PHONE=0242205331
NEXT_PUBLIC_STORE_EMAIL=info@rnhimports.com
NEXT_PUBLIC_STORE_ADDRESS=Amasaman Achiaman, Annosel Junction
NEXT_PUBLIC_STORE_CITY=Accra
NEXT_PUBLIC_STORE_REGION=Greater Accra
NEXT_PUBLIC_STORE_COUNTRY=GH

# Social Links
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TWITTER_URL=

# Optional
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
integration_recaptcha_secret_key=
NEXT_PUBLIC_SKU_PREFIX=RNH
